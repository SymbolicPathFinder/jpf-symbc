#target=npe.IfnullTest
#target=npe.IfnonnullTest
target=npe.StringContainsTest


classpath=${jpf-symbc}/build/examples
symbolic.dp=z3bitvector
symbolic.min_int=-2147483648
symbolic.max_int=2147483647
symbolic.min_double=-10000.0
symbolic.max_double=10000.0
symbolic.bvlength=64
search.depth_limit=13
symbolic.strings=true
symbolic.string_dp=z3str3
symbolic.lazy=on
symbolic.jrarrays=true
veritestingMode = 5
recursiveDepth= 200
singlePathOptimization=true
#listener = .symbc.VeritestingListener
listener = .symbc.SymbolicListener
#,.symbc.SymbolicListener

#symbolic.string_dp_timeout_ms=3000
#symbolic.string_dp=igen
#symbolic.dp=z3bitvectorinc
#symbolic.arrays=true
#,gov.nasa.jpf.symbc.sequences.SymbolicSequenceListener
#symbolic.optimizechoices=false
symbolic.debug=true
